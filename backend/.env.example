PORT=3002
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:5173

# Clave maestra de tokens y tickets: 32+ bytes en base64. Generar con: openssl rand -base64 32
GAME_TOKEN_SECRET=
# Semilla de la cancion diaria (cadena aleatoria larga). Cambiarla cambia todas las canciones del dia.
DAILY_SEED=

# Servidor Node local: solo fs. Produccion es la Edge Function de Supabase (DEC-57, DESARROLLO.md).
STORAGE_DRIVER=fs
# Raiz local con catalog/catalog.json y clips/<clipKey>.mp3 (la genera scripts/catalog en data/out)
STORAGE_DIR=../scripts/catalog/data/out

CLIP_TICKET_TTL_SEC=60
CLIP_CACHE_MB=32
TRUST_PROXY=1

# Limites por minuto (opcionales; estos son los valores por defecto)
# RATE_LIMIT_GLOBAL=120
# RATE_LIMIT_CREATE_GAME=20
# RATE_LIMIT_ACTION=40
# RATE_LIMIT_CLIPS=30
# RATE_LIMIT_PER_GAME=12
